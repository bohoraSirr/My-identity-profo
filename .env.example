# Copy this file to `.env.local` and fill in the values.
#
# Public origin of the site. Used for SEO metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
#
# Formspree form ID (the part after https://formspree.io/f/).
# Create a free form at https://formspree.io and paste the ID here.
# Leave empty and the contact form will fall back to a mailto prompt.
NEXT_PUBLIC_FORMSPREE_ID=
